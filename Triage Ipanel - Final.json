    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"role\": \"user\",\n      \"parts\": [\n        {\n          \"text\": \"Sos un asistente de un negocio de venta y reparación de celulares. Leé este mensaje de un cliente y respondé SOLO con un JSON, sin texto adicional ni explicación, con este formato exacto: {\\\"tipo\\\": \\\"Consulta de venta\\\" o \\\"Garantía\\\" o \\\"Servicio técnico\\\", \\\"prioridad\\\": \\\"VIP\\\" o \\\"Normal\\\", \\\"resumen\\\": \\\"resumen corto en una linea\\\"}. Mensaje del cliente: {{ $json['Mensaje del Cliente'] }}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -720,
        800
      ],
      "id": "fa3c56a6-5f2a-4b6f-a7d2-f201a7615e63",
      "name": "Clasificar Consulta con IA (Gemini)",
      "credentials": {
        "httpHeaderAuth": {
          "id": "tmM4wRcbv2s0At1Y",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "try {\n  const rawText = $input.item.json.candidates[0].content.parts[0].text;\n  const cleaned = rawText.replace(/```json/g, '').replace(/```/g, '').trim();\n  const parsed = JSON.parse(cleaned);\n\n  if (!parsed.tipo || !parsed.prioridad || !parsed.resumen) {\n    throw new Error('La IA devolvió un JSON incompleto');\n  }\n\n  return {\n    tipo: parsed.tipo,\n    prioridad: parsed.prioridad,\n    resumen: parsed.resumen,\n    aiError: false\n  };\n} catch (err) {\n  return {\n    aiError: true,\n    errorMessage: 'Fallo al parsear respuesta de IA: ' + err.message\n  };\n}"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
